# Unity 장면·프리팹은 텍스트(YAML)로 저장되므로 줄바꿈만 맞춘다
* text=auto
*.cs text eol=lf diff=csharp
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf

# 이미지·폰트·오디오는 바이너리
*.png binary
*.jpg binary
*.psd binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.fbx binary
